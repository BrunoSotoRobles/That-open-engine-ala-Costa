# MCP WebSocket URL for Claude Desktop integration.
# When set, the app connects to the Costa MCP server for load-ifc, etc.
# Leave unset in production to avoid connection attempts.
VITE_MCP_WS_URL=ws://localhost:8081

# Firebase (only if COSTA_FIREBASE_OFF_V1 is false). Copy values from Firebase console;
# do not commit .env.local. Rotate keys if they were ever pushed to git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Landing "team password" (Vite embeds at build). Set in Netlify env for preview.
# VITE_TEAM_GATE_PASSWORD=

# Optional Netlify HTTP Basic Auth (separate from in-app button; Free plan)
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
